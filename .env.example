# 복사해서 .env로 쓰고 값을 채운다. 키 값은 깃에 올리지 않는다.
# 기본값은 fake(구글 호출 없음). real로 바꿔야 구글을 부른다.
PLACES_MODE=fake
# 서버 키: Places API만 허용. 브라우저로 보내지 않는다.
GOOGLE_PLACES_KEY=
# 브라우저 키: Maps JavaScript API, 사이트 주소로 제한.
GOOGLE_MAPS_BROWSER_KEY=
# 개발 모드(디버그). 내 컴퓨터에서 개발할 때만 1로 켠다. 없으면 꺼짐. 배포 환경에는 넣지 않는다.
# FLASK_DEBUG=1
# 가짜 모드의 가정 시각(HH:MM). 기본 22:30
# FAKE_NOW=22:30
